# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Supabase Server-Only Secret Key (Never expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Shared key used only to create instructor prototype classes.
# Set a long random value in Vercel and share it only with prototype reviewers.
INSTRUCTOR_PROTOTYPE_KEY=your_long_random_prototype_key_here
